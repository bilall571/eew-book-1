{
  "rules": {
     ".read": false,
    ".write": false,

    "stats": {
      ".read": "auth != null && auth.token.admin === true",
      ".write": "auth != null && auth.token.admin === true"
    },
    "onlineUsers": {
      ".read": "auth != null && auth.token.admin === true",
      "$uid": { ".write": "auth != null && auth.uid === $uid" }
    }
  }
}
